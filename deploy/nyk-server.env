# Environment for the NYK Support Portal server (read by systemd).
# Copy to /etc/nyk-server.env and fill in. Keep this file readable only by root
# and the nyk user (chmod 640), because it holds secrets.

# Public domain. Used for the TLS certificate (standalone mode) AND for
# WebSocket origin checks (always). Must match the subdomain browsers use.
NYK_DOMAIN=support.CHANGE-ME.example.com

# --- Reverse-proxy mode (shared box: nginx/Apache/caddy already terminates TLS) ---
# Set these two to run behind an existing proxy instead of taking over :443.
# The server then serves plain HTTP on NYK_ADDR and the proxy forwards to it.
# Leave NYK_BEHIND_PROXY unset (or empty) to use built-in automatic TLS on :443.
#NYK_BEHIND_PROXY=1
#NYK_ADDR=127.0.0.1:3000   # the local port your proxy forwards this subdomain to

# Where the SQLite database lives (must be under the service's ReadWritePaths).
NYK_DB=/var/lib/nyk/nyk.db

# Where autocert caches issued TLS certificates.
NYK_TLS_CACHE=/var/lib/nyk/tls-cache

# Directory of the built console web app (copied from console/frontend/dist).
NYK_CONSOLE_DIR=/var/lib/nyk/console

# Shared secret every agent build must present to register. Generate with:
#   openssl rand -hex 24
# Bake the SAME value into the agent build (ldflags, see CI) and keep it secret.
NYK_ORG_KEY=CHANGE-ME-ORG-KEY

# TURN relay (coturn on this same VPS).
NYK_TURN_HOST=turn.CHANGE-ME.example.com:3478
# Optional TLS TURN URL for restrictive networks:
# NYK_TURN_TLS=turns:turn.CHANGE-ME.example.com:5349
# MUST equal coturn's static-auth-secret. Generate with: openssl rand -hex 24
NYK_TURN_SECRET=CHANGE-ME-LONG-RANDOM-SECRET
